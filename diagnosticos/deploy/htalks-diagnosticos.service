[Unit]
Description=H-TALKS Diagnosticos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=htalks-diagnosticos
Group=htalks-diagnosticos
WorkingDirectory=/opt/htalks-diagnosticos/current
EnvironmentFile=/etc/htalks-diagnosticos.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/htalks-diagnosticos

[Install]
WantedBy=multi-user.target
